  color: #80d6b7;
}

.workspace-title {
  flex: 1;
  color: #f2f7f5;
  font-size: 21px;
  font-weight: bold;
  text-align: center;
}

.mode-bar {
  width: 100%;
  height: 40px;
  margin-top: 4px;
  border-width: 1px;
  border-color: #344a41;
  border-radius: 5px;
  background-color: #18231f;
  flex-direction: row;
  align-items: center;
}

.mode-arrow {
  width: 44px;
  height: 36px;
  color: #66d9b1;
  font-size: 28px;
  line-height: 36px;
  text-align: center;
}

.mode-copy {
  flex: 1;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.mode-name {
  color: #edf5f1;
  font-size: 14px;
  font-weight: bold;
}

.mode-count {
  margin-left: 8px;
  color: #849a92;
  font-size: 11px;
}

.input-panel {
  width: 100%;
  min-height: 100px;
  margin-top: 6px;
  padding: 7px;
  border-width: 1px;
  border-color: #34483f;
  border-radius: 5px;
  background-color: #171f1c;
  flex-direction: column;
}

.input-row {
  width: 100%;
  height: 40px;
  padding-right: 8px;
  padding-left: 8px;
  border-radius: 3px;
  background-color: #121916;
  flex-direction: row;
  align-items: center;
}

.input-row-active {
  border-left-width: 3px;
  border-left-color: #54d1a4;
  background-color: #18251f;
}

.line-label {
  width: 58px;
  color: #789088;
  font-size: 11px;
}

.line-scroll {
  flex: 1;
  height: 38px;
}

.line-value {
  height: 38px;
  color: #f2cf82;
  font-size: 17px;
  line-height: 38px;
}

.input-hint {
  width: 100%;
  height: 24px;
  padding-left: 8px;
  color: #758a83;
  font-size: 10px;
  line-height: 24px;
}

.keyboard {
  width: 100%;
  flex: 1;
  margin-top: 5px;
  flex-direction: column;
}

.layer-tabs {
  width: 100%;
  height: 28px;
  flex-direction: row;
  align-items: center;
}

.layer-tab {
  width: 62px;
  height: 24px;
  margin-right: 5px;
  border-radius: 3px;
  background-color: #1b2722;
  color: #8ba199;
  font-size: 11px;
  line-height: 24px;
  text-align: center;
}

