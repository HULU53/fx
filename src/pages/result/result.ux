<template>
  <div class="page result-page">
    <div class="result-head">
      <text class="head-btn" onclick="backToInput">返回</text>
      <text class="result-title">{{resultTitle}}</text>
      <text class="head-spacer"></text>
    </div>

    <scroll class="result-scroll" scroll-y="{{true}}">
      <div class="error-panel" if="{{hasError}}">
        <text class="error-title">暂时无法计算</text>
        <text class="error-text">{{errorText}}</text>
        <text class="error-tip">返回检查输入，或打开“说明”查看支持的写法。</text>
      </div>

      <div class="result-card" if="{{!hasError}}">
        <text class="section-kicker">精确结果</text>
        <text class="exact-text" for="line in exactLines">{{line}}</text>
        <text class="approx-text" if="{{hasApproximate}}">近似值：{{approximateText}}</text>
        <text class="domain-text" if="{{hasDomain}}">{{domainText}}</text>
      </div>

      <div class="step-card" if="{{showSteps}}">
        <text class="section-kicker">关键步骤</text>
        <text class="steps-text" for="line in stepLines">{{line}}</text>
      </div>

      <text class="graph-tip" if="{{hasGraph}}">函数算式已整理完成，可进入独立页面查看图像。</text>
    </scroll>

    <div class="result-actions">
      <text class="action-btn graph-btn" if="{{hasGraph}}" onclick="openGraph">显示图像</text>
      <text class="action-btn" onclick="backToInput">继续修改</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import settings from '../../common/settings.js'
import session from '../../common/session.js'
import modules from '../../common/modules.js'
import logger from '../../common/logger.js'

export default {
  private: {
    resultTitle: '计算结果',
    hasError: false,
    errorText: '',
    exactLines: [],
    hasApproximate: false,
    approximateText: '',
    hasDomain: false,
    domainText: '',
    showSteps: false,
    stepLines: [],
    hasGraph: false
  },

  onInit() {
    settings.load(value => {
      logger.initialize(value.logEnabled, { showHeader: false }).then(() => {
        logger.info('PAGE_RESULT', 'onInit')
      })
    })
    session.loadResult(record => {
      this.applyRecord(record)
    })
  },

  applyRecord(record) {
    if (!record) {
      this.hasError = true
      this.errorText = '没有可显示的计算结果'
      return
    }
    const module = modules.findModule(record.moduleId)
    const result = record.result
    this.resultTitle = result.title || (module ? module.title : '计算结果')
    this.hasError = !result.ok
    this.errorText = result.error || '未知错误'
    this.exactLines = result.exact || []
    const approximate = result.approximate || []
    this.hasApproximate = approximate.length > 0
    this.approximateText = approximate.join('  ')
    this.hasDomain = Boolean(result.domain)
    this.domainText = result.domain ? '定义域/限制：' + result.domain : ''
    this.stepLines = (result.steps || []).map(function (step, index) {
      return (index + 1) + '. ' + step
    })
    this.hasGraph = Boolean(result.graph)
    settings.load(value => {
      this.showSteps = value.studentMode && result.ok && this.stepLines.length > 0
    })
    logger.info('PAGE_RESULT', 'result loaded', {
      moduleId: record.moduleId,
      modeId: record.modeId,
      ok: result.ok,
      kind: result.kind
    })
  },

  openGraph() {
    logger.info('UI', 'open function graph')
    router.push({ uri: '/pages/graph' })
  },

  backToInput() {
    session.clearResult()
    router.back()
  }
}
</script>

<style>
