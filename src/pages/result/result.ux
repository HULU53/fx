  font-size: 19px;
  line-height: 30px;
}

.approx-text,
.domain-text {
  width: 100%;
  margin-top: 6px;
  color: #a7bbb4;
  font-size: 12px;
  line-height: 20px;
}

.domain-text {
  color: #e6ba63;
}

.error-title {
  color: #ffb5b5;
  font-size: 20px;
