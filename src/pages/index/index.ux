  width: 100%;
  height: 334px;
  margin-top: 6px;
}

.module-page {
  width: 100%;
  height: 100%;
  padding-top: 4px;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}

.module-card {
  width: 100%;
  height: 100px;
  margin-bottom: 8px;
  padding-left: 18px;
  border-radius: 18px;
  background-color: #2a2f36;
  flex-direction: column;
  flex-shrink: 0;
  justify-content: center;
}

.module-title {
  width: 100%;
  height: 36px;
  color: #f2f7f5;
  font-size: 24px;
  font-weight: bold;
  line-height: 36px;
  text-align: left;
}

.module-summary {
  width: 100%;
  height: 26px;
  color: #b8c7d8;
