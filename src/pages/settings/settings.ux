<template>
  <div class="page settings-page">
    <div class="page-head">
      <text class="back-text" onclick="back">返回</text>
      <text class="title settings-title">设置</text>
      <text class="head-spacer"></text>
    </div>

    <scroll class="settings-scroll" scroll-y="{{true}}">
      <div class="settings-list">
        <div class="setting-card">
          <div class="setting-copy">
            <text class="setting-name">学生自学模式</text>
            <text class="setting-detail">在最终结果下增加关键变形步骤</text>
          </div>
          <text class="switch {{studentClass}}" onclick="toggleStudentMode">{{studentText}}</text>
        </div>

        <div class="setting-card">
          <div class="setting-copy">
            <text class="setting-name">日志记录</text>
            <text class="setting-detail">写入应用沙箱，默认开启</text>
          </div>
          <text class="switch {{logClass}}" onclick="toggleLogging">{{logText}}</text>
        </div>

        <div class="path-card">
          <text class="path-label">当前日志</text>
          <text class="path-value">/data/quickapp/files/com.codex.vela.fx/logs/fX.log.txt</text>
          <text class="path-note">达到约 256 KB 后，下次启动会滚动为 fX.log.1.txt</text>
        </div>

        <text class="help-link" onclick="openHelp">查看输入语法与示例</text>
        <text class="save-status">{{statusText}}</text>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router'
import settings from '../../common/settings.js'
import logger from '../../common/logger.js'

export default {
  private: {
    studentText: '关闭',
    logText: '开启',
    studentClass: 'switch-off',
    logClass: 'switch-on',
    statusText: ''
  },

  onInit() {
    settings.load(value => {
      this.applyView(value)
      logger.initialize(value.logEnabled, { showHeader: false }).then(() => {
        logger.info('PAGE_SETTINGS', 'onInit')
      })
    })
  },

  applyView(value) {
    this.studentText = value.studentMode ? '开启' : '关闭'
    this.logText = value.logEnabled ? '开启' : '关闭'
    this.studentClass = value.studentMode ? 'switch-on' : 'switch-off'
    this.logClass = value.logEnabled ? 'switch-on' : 'switch-off'
  },

  toggleStudentMode() {
    const next = !settings.current().studentMode
    settings.update({ studentMode: next }, (ok, value) => {
      this.applyView(value)
      this.statusText = ok ? '设置已保存' : '保存失败，请重试'
      logger.info('SETTINGS', 'student mode changed', next)
    })
  },

  toggleLogging() {
    const next = !settings.current().logEnabled
    if (!next) {
      logger.info('SETTINGS', 'file logging disabled')
    }
    settings.update({ logEnabled: next }, (ok, value) => {
      this.applyView(value)
      this.statusText = ok ? '设置已保存' : '保存失败，请重试'
      logger.configure(next)
      if (next && ok) {
        logger.info('SETTINGS', 'file logging enabled')
      }
    })
  },

  openHelp() {
    router.push({ uri: '/pages/help' })
  },

  back() {
    router.back()
  }
}
</script>

