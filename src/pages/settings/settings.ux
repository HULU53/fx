  width: 100%;
  min-height: 84px;
  margin-bottom: 12px;
  padding: 12px;
  border-width: 2px;
  border-color: #334840;
  border-radius: 6px;
  background-color: #19231f;
  flex-direction: row;
  align-items: center;
}

