  color: #f0f6f3;
  font-size: 18px;
  font-weight: bold;
}

.setting-detail {
  margin-top: 4px;
  color: #8fa49d;
  font-size: 11px;
}

.switch {
  width: 64px;
  height: 42px;
  border-width: 2px;
  border-radius: 4px;
  font-size: 15px;
  line-height: 38px;
  text-align: center;
}

.switch-on {
  border-color: #53d2a5;
  background-color: #24654f;
  color: #ffffff;
}

.switch-off {
  border-color: #52645e;
  background-color: #26322e;
  color: #c4d0cc;
}

.path-card {
  width: 100%;
  margin-top: 2px;
  padding: 12px;
  border-left-width: 4px;
  border-left-color: #d7a643;
  border-radius: 5px;
  background-color: #211f18;
  flex-direction: column;
}

.path-label {
  color: #e9c67e;
  font-size: 13px;
  font-weight: bold;
}

.path-value {
  margin-top: 7px;
  color: #e8eeeb;
  font-size: 11px;
}

.path-note {
  margin-top: 6px;
  color: #9b9179;
  font-size: 10px;
}

.help-link {
  width: 100%;
