<template>
  <div class="page graph-page">
    <div class="graph-head">
      <text class="head-btn" onclick="back">返回</text>
      <text class="graph-title">{{graphTitle}}</text>
      <text class="head-spacer"></text>
    </div>

    <div class="graph-body">
      <div class="loading-panel" if="{{loading}}">
        <text class="loading-text">正在生成函数图像…</text>
      </div>

      <image class="graph-image" src="{{graphImageUri}}" if="{{imageReady}}"></image>

      <div class="error-panel" if="{{hasError}}">
        <text class="error-title">图像显示失败</text>
        <text class="error-text">{{errorText}}</text>
        <text class="retry-btn" onclick="renderGraph">重试</text>
      </div>

      <div class="points-panel" if="{{hasPoints}}">
        <text class="points-title">关键点</text>
        <text class="point-line" for="line in keyPointLines">{{line}}</text>
      </div>
    </div>

    <text class="back-button" onclick="back">返回算式</text>
  </div>
</template>

<script>
import router from '@system.router'
import file from '@system.file'
import session from '../../common/session.js'
import modules from '../../common/modules.js'
import settings from '../../common/settings.js'
import logger from '../../common/logger.js'
import graphImage from '../../common/math/graph-image.js'

export default {
  private: {
    graphTitle: '函数图像',
    loading: true,
    imageReady: false,
    graphImageUri: '',
    hasError: false,
    errorText: '',
    hasPoints: false,
    keyPointLines: [],
    graphData: null
  },

  onInit() {
    settings.load(value => {
      logger.initialize(value.logEnabled, { showHeader: false }).then(() => {
        logger.info('PAGE_GRAPH', 'onInit')
      })
    })
    session.loadResult(record => {
      if (!record || !record.result || !record.result.graph) {
        this.showFailure('当前结果不包含可绘制的函数图像')
        return
      }
      const module = modules.findModule(record.moduleId)
      this.graphTitle = module ? module.title : '函数图像'
      this.graphData = record.result.graph
      this.keyPointLines = (this.graphData.keyPoints || []).map(function (point) {
        const label = point.label || '关键点'
        return label + '：(' + Number(point.x.toFixed(2)) + ', ' + Number(point.y.toFixed(2)) + ')'
      })
      this.hasPoints = this.keyPointLines.length > 0
      this.renderGraph()
    })
  },

  renderGraph() {
    if (!this.graphData) {
      return
    }
    this.loading = true
    this.hasError = false
    this.imageReady = false
    try {
      const bytes = graphImage.createGraphPng(this.graphData)
      const directory = 'internal://files/tmp/'
      const uri = directory + 'fx-graph-' + Date.now() + '.png'
      this.ensureDirectory(directory).then(() => {
        return this.writeImage(uri, bytes)
      }).then(() => {
        this.graphImageUri = uri
        this.imageReady = true
        this.loading = false
        logger.info('GRAPH', 'png rendered', this.graphData.type)
      }).catch(error => {
        this.showFailure(error.message || String(error))
      })
    } catch (error) {
      this.showFailure(error.message || String(error))
    }
  },

  ensureDirectory(uri) {
    return new Promise(resolve => {
      file.access({
        uri: uri,
        success: resolve,
        fail: function () {
          file.mkdir({
            uri: uri,
            recursive: true,
            success: resolve,
            fail: resolve
          })
        }
      })
    })
  },

  writeImage(uri, bytes) {
    return new Promise((resolve, reject) => {
      file.writeArrayBuffer({
        uri: uri,
        buffer: bytes,
        position: 0,
        append: false,
        success: resolve,
        fail: function (data, code) {
          reject(new Error('图片文件写入失败（' + code + '）'))
        }
      })
    })
  },

  showFailure(message) {
    this.loading = false
    this.imageReady = false
    this.hasError = true
    this.errorText = message || '未知错误'
    logger.warn('GRAPH', 'image failed', this.errorText)
  },

  back() {
    router.back()
  }
}
</script>

<style>
@import '../../common/base.css';

