  width: 64px;
  height: 34px;
  border-width: 1px;
  border-color: #40574f;
  border-radius: 4px;
  color: #dce8e3;
  font-size: 13px;
  line-height: 32px;
  text-align: center;
}

.head-spacer {
  width: 64px;
}

.graph-title {
  flex: 1;
  color: #f2f7f5;
  font-size: 21px;
  font-weight: bold;
  text-align: center;
}

.graph-body {
  width: 100%;
  flex: 1;
  padding-top: 8px;
  flex-direction: column;
  align-items: center;
}

.loading-panel,
.error-panel,
.points-panel {
  width: 100%;
  margin-bottom: 10px;
  padding: 12px;
  border-radius: 8px;
  flex-direction: column;
}

.loading-panel {
  background-color: #19231f;
}

.loading-text {
  width: 100%;
  color: #8fd8bd;
  font-size: 14px;
  text-align: center;
}

.graph-image {
  width: 384px;
  height: 260px;
  margin-bottom: 10px;
  border-radius: 6px;
  background-color: #111916;
  object-fit: contain;
}

.error-panel {
  border-width: 2px;
  border-color: #814e4e;
  background-color: #2a1d1d;
}

.error-title {
  width: 100%;
  color: #ffb9b9;
  font-size: 18px;
  font-weight: bold;
}

.error-text {
  width: 100%;
  margin-top: 6px;
  color: #e7d0d0;
  font-size: 12px;
  line-height: 20px;
}

.retry-btn {
  width: 100%;
  height: 36px;
  margin-top: 9px;
  border-radius: 6px;
  background-color: #603434;
  color: #ffffff;
  font-size: 14px;
  line-height: 36px;
  text-align: center;
}

.points-panel {
  border-width: 1px;
  border-color: #51462f;
  background-color: #211f19;
}

.points-title {
  width: 100%;
  color: #e5bd6b;
  font-size: 13px;
  font-weight: bold;
}

.point-line {
  width: 100%;
  margin-top: 4px;
  color: #c9c0ad;
  font-size: 11px;
  line-height: 18px;
}

.back-button {
  width: 84%;
  height: 42px;
  align-self: center;
  border-width: 2px;
  border-color: #4acb9c;
  border-radius: 8px;
  background-color: #24664f;
  color: #ffffff;
  font-size: 15px;
  line-height: 38px;
  text-align: center;
}
</style>
